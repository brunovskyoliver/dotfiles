# Session picker: Ctrl+A, then Q. Esc closes the picker.
bind-key "q" run-shell "sesh connect \"$(
  sesh list --icons | fzf-tmux -p 100%,100% \
    --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
    --color='dark,bg:#1a1b26,bg+:#292e42,fg:#c0caf5,fg+:#ffffff,hl:#7dcfff,hl+:#7dcfff,border:#565f89,header:#7aa2f7,prompt:#7dcfff,pointer:#bb9af7,marker:#9ece6a,info:#a9b1d6,spinner:#bb9af7,preview-bg:#1a1b26,preview-fg:#c0caf5' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d kill session ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-d:execute-silent(tmux kill-session -t \"=\"{2..})+reload(sesh list --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}'
)\""

# New windows and splits open in the current pane's directory.
bind c new-window -c '#{pane_current_path}'
bind - split-window -v -c '#{pane_current_path}'
bind _ split-window -h -c '#{pane_current_path}'

# Return to the previously active window or session.
bind Tab last-window
bind BTab switch-client -l

# Close the current pane without a confirmation prompt.
bind x kill-pane

# Match Ghostty's TokyoNight colors instead of tmux's default gray popup.
set -g popup-style 'bg=#1a1b26,fg=#c0caf5'
set -g popup-border-style 'bg=#1a1b26,fg=#565f89'
